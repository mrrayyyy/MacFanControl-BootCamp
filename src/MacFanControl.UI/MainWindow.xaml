<Window x:Class="MacFanControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MacFanControl.UI"
        xmlns:vm="clr-namespace:MacFanControl.UI.ViewModels"
        mc:Ignorable="d"
        Title="MacFanControl BootCamp (MBP 16&quot; 2019)"
        Height="780" Width="1000"
        MinHeight="720" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Nav -->
            <RowDefinition Height="*"/>    <!-- Main Tab Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER & MODERN SEGMENTED NAVIGATION -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Device Badge -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C2130" BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text=" SMC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock Text="MacFanControl BootCamp" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    
                    <!-- Live SMC Connected Badge -->
                    <Border Background="#122A1E" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Apple T2 SMC Connected" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="MacBook Pro 16&quot; (2019) • Intel Core i9-9880H • AMD Radeon Pro • Windows BootCamp" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Segmented Navigation Tabs -->
            <Border Grid.Column="1" Background="#181922" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- Tab 0: Fan Control -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="0" Height="34" Padding="14,0" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎛️" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Fan Control" FontWeight="SemiBold" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 1: Sensors -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="1" Height="34" Padding="14,0" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🌡️" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Sensors" FontWeight="SemiBold" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 2: Settings -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="2" Height="34" Padding="14,0" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⚙️" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 3: Diagnostics -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="3" Height="34" Padding="14,0" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📋" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Logs" FontWeight="SemiBold" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. TAB CONTENT CONTAINER -->
        <!-- TAB 0: FAN CONTROL (ĐIỀU KHIỂN QUẠT THEO NHIỆT ĐỘ) -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Overview Metrics -->
                <RowDefinition Height="Auto"/> <!-- Mode Selector -->
                <RowDefinition Height="*"/>    <!-- Curve Tuning Panels -->
            </Grid.RowDefinitions>

            <!-- 4 LIVE METRIC TILES (CPU, GPU, LEFT FAN, RIGHT FAN) -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU PACKAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Core i9" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding Overview.CpuPackageTemp, StringFormat='{}{0:F1}'}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" °C" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="{Binding Overview.CpuPowerWatts, StringFormat='Power: {0:F0}W'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Overview.CpuUsagePercent, StringFormat='Load: {0:F0}%'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU CORE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Radeon Pro" FontSize="10" Foreground="{StaticResource AccentOrangeBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding Overview.GpuTemp, StringFormat='{}{0:F1}'}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" °C" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="{Binding Overview.GpuPowerWatts, StringFormat='Power: {0:F0}W'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Overview.GpuUsagePercent, StringFormat='Load: {0:F0}%'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Left Fan (CPU) Card -->
                <Border Grid.Column="4" Style="{StaticResource ModernCard}" Padding="12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="FAN 1 • LEFT (CPU)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Fan0.Percentage, StringFormat='{}{0:F0}%'}" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding Fan0.CurrentRpm, StringFormat='{}{0:F0}'}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" RPM" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding Fan0.Percentage, Mode=OneWay}" Height="5"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding Fan0.MinRpm, StringFormat='Min: {0:F0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Fan0.MaxRpm, StringFormat='Max: {0:F0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Fan (GPU) Card -->
                <Border Grid.Column="6" Style="{StaticResource ModernCard}" Padding="12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="FAN 2 • RIGHT (GPU)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Fan1.Percentage, StringFormat='{}{0:F0}%'}" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding Fan1.CurrentRpm, StringFormat='{}{0:F0}'}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text=" RPM" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding Fan1.Percentage, Mode=OneWay}" Height="5"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding Fan1.MinRpm, StringFormat='Min: {0:F0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Fan1.MaxRpm, StringFormat='Max: {0:F0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MODE SELECTOR BAR -->
            <Border Grid.Row="1" Background="#161720" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Control Mode:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,14,0"/>

                    <UniformGrid Grid.Column="1" Columns="3">
                        <!-- Apple Auto Mode -->
                        <Button Command="{Binding SetAppleAutoCommand}" Height="34" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#1E202B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMode}" Value="AppleAuto">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍏 Apple Default (SMC Auto)" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Custom Temp Curve Mode -->
                        <Button Command="{Binding SetCurveCommand}" Height="34" Margin="3,0,3,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#1E202B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMode}" Value="Curve">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ Custom Temp Control (Tự chỉnh)" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- 100% Turbo Mode -->
                        <Button Command="{Binding SetTurboCommand}" Height="34" Margin="6,0,0,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#1E202B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMode}" Value="Turbo">
                                            <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀 100% Turbo Max" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- 1. APPLE AUTO MODE STATUS CARD (HIỆN KHI CHỌN APPLE DEFAULT) -->
            <Border Grid.Row="2" Padding="32,28">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedMode}" Value="AppleAuto">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Icon & Title -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#162E20" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="🍏" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Chế độ Mặc định Apple (Apple SMC Auto)" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hệ thống SMC đang tự động quản lý quạt theo thuật toán Apple" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Explanatory Box -->
                    <Border Grid.Row="1" Background="#161822" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="• Quạt được điều khiển hoàn toàn tự động bởi chip Apple SMC theo tiêu chuẩn macOS / Boot Camp." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="• Tùy chỉnh đường cong nhiệt độ được ẩn vì phần mềm không can thiệp vào vòng quay quạt ở chế độ này." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="• Để tự đặt nhiệt độ và mức quay quạt cho từng quạt, hãy chuyển sang chế độ Custom Temp Control." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Current Status Readout -->
                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,18">
                        <Border Background="#1C1E2A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Quạt Trái (CPU)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Fan0.CurrentRpm, StringFormat='{}{0:F0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" RPM" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C1E2A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Quạt Phải (GPU)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Fan1.CurrentRpm, StringFormat='{}{0:F0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" RPM" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Switch to Custom Mode Button -->
                    <Button Grid.Row="3" Command="{Binding SetCurveCommand}" Style="{StaticResource ModernButton}" Height="34" Padding="18,0" HorizontalAlignment="Center" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ Chuyển sang Tùy chỉnh quạt theo nhiệt độ" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. 100% TURBO MAX STATUS CARD (HIỆN KHI CHỌN 100% TURBO) -->
            <Border Grid.Row="2" Padding="32,28">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedMode}" Value="Turbo">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Icon & Title -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#331416" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="🚀" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Chế độ 100% Turbo Max (Làm mát cực đại)" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Cả hai quạt đang được khóa cố định ở mức 100% công suất" FontSize="12" Foreground="{StaticResource AccentRedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Explanatory Box -->
                    <Border Grid.Row="1" Background="#161822" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="• Cả hai quạt (Left Fan &amp; Right Fan) đang chạy ở tốc độ tối đa (~5900 RPM) để giải nhiệt tức thì." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="• Tùy chỉnh đường cong nhiệt độ được ẩn vì quạt luôn chạy hết công suất liên tục." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="• Khuyến nghị sử dụng khi xuất video nặng, 3D render hoặc chơi game đồ họa cao để hạ nhiệt nhanh." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Current Status Readout -->
                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,18">
                        <Border Background="#1C1E2A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Quạt Trái (CPU) - 100% MAX" FontSize="11" Foreground="{StaticResource AccentRedBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Fan0.CurrentRpm, StringFormat='{}{0:F0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" RPM" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

