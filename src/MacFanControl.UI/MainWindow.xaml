                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding RightMaxPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepperTextBoxStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                                    <Grid Grid.Column="2" Margin="0,1,1,1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Button Grid.Row="0" Style="{StaticResource SpinnerButtonStyle}" Command="{Binding ChangeRightMaxPercentCommand}" CommandParameter="5" ToolTip="Tăng 5 %">
                                                            <Path Data="M0,4 L3.5,0 L7,4" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <Button Grid.Row="1" Style="{StaticResource SpinnerButtonStyle}" Command="{Binding ChangeRightMaxPercentCommand}" CommandParameter="-5" ToolTip="Giảm 5 %">
                                                            <Path Data="M0,0 L3.5,4 L7,0" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Tốc độ quạt mức tối đa" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Live Right Calculated Speed Preview -->
                                <Border Grid.Row="3" Background="#111218" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" VerticalAlignment="Bottom">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Nhiệt độ hiện tại:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SmoothedRightTemp, StringFormat='{}{0:F1} °C'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="Tốc độ mục tiêu tính toán:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CalculatedRightRpm, StringFormat='{}{0:F0} RPM'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding CalculatedRightPercent, Mode=OneWay}" Height="4" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Anti-Jitter Status Indicator Bar -->
                    <Border Grid.Row="2" Background="#13141D" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Anti-Jitter Smooth Engine:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Bộ lọc EMA và giới hạn bước tốc (Slew-rate limit) đang hoạt động, giúp quạt tăng giảm êm ái, không bị hú rít giật cục." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Tự động lưu cấu hình ✓" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- TAB 1: SENSORS (DANH SÁCH TOÀN BỘ CẢM BIẾN PHẦN CỨNG) -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Filters & Search -->
                <RowDefinition Height="*"/>    <!-- Sensors List -->
            </Grid.RowDefinitions>

            <!-- Search & Category Filters -->
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Grid.Column="0" Text="{Binding SensorSearchText, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,4" VerticalContentAlignment="Center"/>

                    <!-- Category Pills -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="1" Click="FilterCategory_Click" Tag="All" Content="Tất cả" Style="{StaticResource ModernButton}" Height="30" Padding="10,0" Margin="0,0,6,0"/>

                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="1" Click="FilterCategory_Click" Tag="Temperatures" Content="🌡️ Nhiệt độ" Style="{StaticResource ModernButton}" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="1" Click="FilterCategory_Click" Tag="Loads" Content="📊 Mức tải (%)" Style="{StaticResource ModernButton}" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="1" Click="FilterCategory_Click" Tag="CPU" Content="CPU" Style="{StaticResource ModernButton}" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="1" Click="FilterCategory_Click" Tag="GPU" Content="GPU" Style="{StaticResource ModernButton}" Height="30" Padding="10,0" Margin="0,0,6,0"/>
                    </StackPanel>

                    <!-- Sensor Count -->
                    <TextBlock Grid.Column="2" Text="{Binding DisplayedSensors.Count, StringFormat='Hiển thị {0} cảm biến'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Sensors Data Table View -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Grid Grid.Row="0" Margin="10,4,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="PHÂN LOẠI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="TÊN CẢM BIẾN / THIẾT BỊ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="MỨC ĐỘ HIỆN TẠI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="3" Text="GIÁ TRỊ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="MIN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="MAX" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Separator Grid.Row="0" Background="{StaticResource CardBorderBrush}" VerticalAlignment="Bottom" Margin="0,0,0,-4"/>

                    <!-- Sensor Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding DisplayedSensors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#161822" BorderBrush="#202230" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Badge -->
                                            <Border Grid.Column="0" Background="#1D202E" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}"/>
                                            </Border>

                                            <!-- Sensor Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Visual Level Bar -->
                                            <ProgressBar Grid.Column="2" Value="{Binding ValueRatio, Mode=OneWay}" Maximum="1" Height="6" VerticalAlignment="Center" Margin="4,0,14,0"/>

                                            <!-- Value -->
                                            <TextBlock Grid.Column="3" Text="{Binding FormattedValue}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Min Peak -->
                                            <TextBlock Grid.Column="4" Text="{Binding FormattedMin}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- Max Peak -->
                                            <TextBlock Grid.Column="5" Text="{Binding FormattedMax}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- TAB 2: SETTINGS (CÀI ĐẶT HỆ THỐNG & KHỞI ĐỘNG CÙNG WINDOWS) -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Group 1: Windows Integration & Startup -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🚀 Tích Hợp Hệ Thống &amp; Khởi Động Cùng Windows" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Cấu hình khởi động tự động không hỏi quyền UAC thông qua Windows Task Scheduler." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,12"/>

                            <!-- Start With Windows Checkbox -->
                            <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="Khởi động cùng Windows khi người dùng đăng nhập (Start with Windows)" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <!-- Startup Mode (Open with Window vs Start Minimized) -->
                            <Border Background="#161822" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="24,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Hành vi khi khởi động cùng hệ thống:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <RadioButton IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" Content="Khởi động ngầm trong khay hệ thống (Start Minimized to Tray)" Margin="0,0,0,6"/>
                                    <RadioButton IsChecked="{Binding OpenWindowOnStart, Mode=TwoWay}" Content="Mở giao diện ứng dụng khi khởi động (Open Window on Start)"/>
                                </StackPanel>
                            </Border>

                            <!-- Minimize on Close Checkbox -->
                            <CheckBox IsChecked="{Binding MinimizeOnClose, Mode=TwoWay}" Content="Thu nhỏ xuống khay hệ thống khi bấm nút đóng [X] (Minimize to Tray on Close)" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Group 2: Fan Smoothing & Anti-Jitter -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🌊 Độ Mượt &amp; Bộ Lọc Chống Giật Điều Tốc Quạt" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Giúp quạt MacBook Pro tăng giảm tốc độ êm ái tự nhiên, tránh hiện tượng hú rít lúc to lúc nhỏ." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,12"/>

                            <CheckBox IsChecked="{Binding EnableSmoothing, Mode=TwoWay}" Content="Bật bộ lọc làm mượt chống giật quạt (Enable Anti-Jitter Smoothing)" FontWeight="SemiBold" Margin="0,0,0,14"/>

                            <!-- Ramp Up Speed Slider -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tốc độ tăng quạt (Ramp Up Step):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="100" Maximum="500" Value="{Binding RampUpStepRpm, Mode=TwoWay}" SmallChange="25" LargeChange="50" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RampUpStepRpm, StringFormat='{}{0:F0} RPM'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Ramp Down Speed Slider -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tốc độ giảm quạt (Ramp Down Step):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="30" Maximum="250" Value="{Binding RampDownStepRpm, Mode=TwoWay}" SmallChange="10" LargeChange="25" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RampDownStepRpm, StringFormat='{}{0:F0} RPM'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Polling Interval -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Chu kỳ quét cảm biến (Polling Rate):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" SelectedValue="{Binding PollingIntervalMs, Mode=TwoWay}" SelectedValuePath="Tag" Height="28">
                                    <ComboBoxItem Content="1.0 giây (Phản hồi nhanh)" Tag="1000"/>
                                    <ComboBoxItem Content="1.5 giây (Tiêu chuẩn cân bằng)" Tag="1500"/>
                                    <ComboBoxItem Content="2.0 giây (Tiết kiệm tài nguyên)" Tag="2000"/>
                                    <ComboBoxItem Content="3.0 giây (Chậm)" Tag="3000"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Group 3: Device Info & Save Actions -->
                    <Border Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thiết Bị: MacBookPro16,1 (MacBook Pro 16&quot; 2019)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Cấu hình được lưu tự động tại: %AppData%\MacFanControlBootCamp\settings.json" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ResetSettingsCommand}" Content="🔄 Khôi Phục Mặc Định" Style="{StaticResource ModernButton}" Height="34" Padding="14,0" Margin="0,0,10,0"/>
                                <Button Command="{Binding SaveSettingsCommand}" Content="💾 Lưu Cài Đặt Ngay" Style="{StaticResource PrimaryButton}" Height="34" Padding="18,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TAB 3: DIAGNOSTICS & LOGS -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Action Bar -->
                <RowDefinition Height="*"/>    <!-- Log Output -->
            </Grid.RowDefinitions>

            <!-- Action Bar -->
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="System Diagnostic &amp; Apple SMC Inspector" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Kiểm tra IOCTL driver, FourCC SMC keys (FNum, F0Ac, F1Ac, F0Tg, F1Tg, FS!)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RunDiagnosticCommand}" Content="🔍 Chạy Chẩn Đoán Probe" Style="{StaticResource ModernButton}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                        <Button Command="{Binding CopyLogsCommand}" Content="📋 Sao Chép (Copy)" Style="{StaticResource ModernButton}" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                        <Button Command="{Binding ExportLogsCommand}" Content="💾 Xuất Ra File" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Real-time Log Viewer -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Margin="0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C8CAD4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Smc">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. FOOTER STATUS BAR -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Đóng cửa sổ này sẽ tự động thu nhỏ xuống Khay hệ thống (System Tray)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
